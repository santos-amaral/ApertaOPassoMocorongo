programa {
    funcao inicio (){
    inteiro numTab
    inteiro reais
    real cambio
    numTab = 0
    cambio = 5.16
    reais = 0

    escreva ("Olá, jovem. É bom nos prepararmos para o câmbio americano!\n")
    escreva ("Qual o valor em Dólares Americanos que deseja converter para a nossa moeda?")
    leia(numTab)

         {
        reais = cambio * numTab
        escreva ("R$: ", reais)
        
        }
    }
}
